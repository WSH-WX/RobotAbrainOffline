# RabbitBot portable 运行模式默认模板（随仓库迁移）。
# 本文件不直接被 systemd 加载；实际运行配置为 runtime/portable.env，由 deploy/bootstrap_host.sh
# 在目标机器上从本模板复制生成，并写入本机路径、模型目录、网卡等本机配置。
# runtime/portable.env 属于本机运行态文件，不进入 Git；修改可迁移默认值请改本模板。

RABBITBOT_RUNTIME_MODE=portable
RABBITBOT_NAV_RUNTIME=compose
# 基础服务运行方式：compose=解耦多容器栈(docker/portable/docker-compose.decoupled.yaml：
#   neo4j / rabbitbot-vlm / rabbitbot-audio / rabbitbot-memory / rabbitbot-workflow)；unified=旧单容器(回退)。默认 compose。
# 注意：解耦栈的 rabbitbot-vlm 恒起 VLM(8000)+Embedding(8005)、rabbitbot-audio 恒起 TTS(28185)+STT(28184)，
# 因此解耦栈会在拉起服务前按需检查/下载相应模型(见 deploy/ensure_models.sh)，不再依赖人工预先执行下载。
RABBITBOT_BASE_RUNTIME=compose
RABBITBOT_PORTABLE_COMPOSE_PROJECT=rabbitbot-portable
RABBITBOT_PORTABLE_COMPOSE_FILE=
RABBITBOT_DECOUPLED_COMPOSE_FILE=
RABBITBOT_PORTABLE_CORE_IMAGE=ghcr.io/aaronai/rabbitbot-core-portable:20260611
RABBITBOT_PORTABLE_NAV_IMAGE=ghcr.io/aaronai/rabbitbot-nav-portable:20260611
# 解耦栈的图数据库容器使用官方 neo4j 镜像(独立于 core/nav)；离线交付随 export/import_portable_images.sh 一并 save/load。
RABBITBOT_NEO4J_IMAGE=neo4j:5.26-community
RABBITBOT_PORTABLE_CORE_BASE_IMAGE=rabbitbot-unified-runtime:20260518
# 镜像来源：local 表示镜像来自本机构建或离线导入；build_or_pull_images.sh 在 local 下默认只校验本地镜像存在，不访问远端仓库。
RABBITBOT_IMAGE_SOURCE=local
# 构建机默认两者都构建；全新 Orin 部署用 MODE=check / MODE=none，不会触发构建。
RABBITBOT_PORTABLE_BUILD_CORE=1
RABBITBOT_PORTABLE_BUILD_NAV=1
# portable 模式下是否为 py38/py310/vln/pyorbbecsdk 注入从 core 镜像 seed 的依赖卷。
RABBITBOT_PORTABLE_INJECT_DEPS=1
# portable 端口拓扑：28180 归属 nav bridge 的 humble_robot_agent_bridge；core 不启动 robot_app.py。
RABBITBOT_UNIFIED_START_ROBOT_AGENT=0
RABBITBOT_DDS_INTERFACE=eno1
RABBITBOT_DDS_HOST_CIDR=192.168.123.222/24
RABBITBOT_NAV_MAP_PATH=/home/unitree/test9.pcd
RABBITBOT_ROS_MASTER_URI=http://kuavo_master:11311
RABBITBOT_ROS_IP=192.168.26.13
RABBITBOT_ROS_HOSTNAME=
RABBITBOT_ENABLE_VLM=1
RABBITBOT_ENABLE_EMBEDDING=1
RABBITBOT_ENABLE_STT=1
RABBITBOT_AUTO_DOWNLOAD_MODELS=1
RABBITBOT_MODELS_CACHE_DIR=
RABBITBOT_MODEL_DOWNLOAD_IMAGE=python:3.11-slim
RABBITBOT_PORTABLE_CORE_CONTAINER_NAME=rabbitbot-unified-runtime
